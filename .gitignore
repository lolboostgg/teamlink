# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/env

# vercel
.vercel

# Unrelated to this project — appears to be dropped in by a local git init
# template (unconnected Claude Code skill pack), not TeamLink content.
/skills

# Raw lolboost.gg asset dump (source material to curate files from into
# public/ — see lib/gameArt.ts, lib/lolAssets.ts). ~60MB, mostly unused;
# kept on disk for future curation but never committed.
/assets

# Full copy of the live lolboost.gg PHP site, dropped in as reference for
# porting its game/rank/champion logic (see lib/gameProfiles.ts). Curated
# files get copied into public/ and src/lib/data/ — the dump itself never
# gets committed.
/live lolboost.gg/

# typescript
*.tsbuildinfo
next-env.d.ts

# Media dropped directly in the repo root by the chat client (a reference
# clip, a batch of key art to curate) — the copy that ships lives under
# public/games/ named for its slug, this one is just the drop point.
/*.mp4
/*.webp

/src/generated/prisma

# Font Awesome subset, rebuilt by scripts/build-icon-css.mjs on every dev/build.
/src/app/generated

# Agent-facing Prisma reference docs, auto-installed by `prisma init` for
# three different AI tool conventions at once — pure documentation, not
# project content, kept on disk locally but not worth the repo noise.
/.agents/skills/prisma-*
/.claude/skills/prisma-*
/.windsurf/skills/prisma-*
/skills-lock.json

# Raw art dumps: 431 banners and 279 icons covering hundreds of games we do
# not list. Curated files are copied into public/games/ under their slug (see
# lib/gameArt.ts); the dumps themselves stay on disk and out of the repo,
# same as the /assets dump above.
/banner
/game-icons
/banner*.jpg
/hangout.png
/hangout icon.png
