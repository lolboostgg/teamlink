// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Real accounts — replaces the mock "teamlink:authenticated" localStorage
// flag once auth is wired up (phase 2). Nullable relations to Order/Review
// below let those keep working before every caller has a real User yet.
model User {
  id                 String   @id @default(cuid())
  // Human-facing account number (#813), handed out in registration order to
  // clients and teammates alike — the id everything user-visible refers to,
  // including the admin profile URL. The cuid stays the DB-internal key.
  accountNo          Int      @unique @default(autoincrement())
  email              String   @unique
  name               String?
  avatarUrl          String?  @db.Text
  // Where the picture sits in its frame, same as on Teammate — see
  // lib/avatarFrame.ts.
  avatarFocusX       Int      @default(50)
  avatarFocusY       Int      @default(50)
  avatarZoom         Int      @default(100)
  passwordHash       String?
  // Discord link. discordId is the immutable snowflake we'd address a DM to;
  // the username/avatar are only a display cache, so a rename on Discord's
  // side shows up the next time the account is re-linked.
  discordId          String?  @unique
  discordUsername    String?
  discordAvatar      String?
  discordLinkedAt    DateTime?
  role               Role     @default(CLIENT)
  creditBalanceCents Int      @default(0)
  // { [topic]: { email, discord, sms } } — see lib/notificationPrefs.ts.
  notificationPrefs  Json?
  createdAt          DateTime @default(now())

  teammate           Teammate?           @relation("UserTeammate")
  ordersAsClient     Order[]             @relation("ClientOrders")
  reviewsWritten     Review[]            @relation("ReviewsWritten")
  creditTransactions CreditTransaction[]
  notifications      Notification[]
  favoriteTeammates  FavoriteTeammate[]
  invitesCreated     TeammateInvite[]    @relation("InvitesCreated")
  inviteUsed         TeammateInvite?     @relation("InviteUsed")
  payoutsProcessed   PayoutRequest[]     @relation("PayoutsProcessed")
  /** Stripe's customer object, created lazily on first checkout. */
  stripeCustomerId   String?             @unique
  savedCards         SavedCard[]
  charges            Charge[]
  gameAccounts       GameAccount[]
  couponsOwned       Coupon[]            @relation("CouponsOwned")
  tipsSent           Tip[]               @relation("TipsSent")
}

/**
 * A card (or wallet) the customer told Stripe to keep for later.
 *
 * Only the identifiers and the display crumbs live here — the number never
 * touches this database. Charging later means sending Stripe the payment
 * method id, which is useless to anyone who does not also hold our secret key.
 */
model SavedCard {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentMethodId String   @unique
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())

  charges Charge[]

  @@index([userId])
}

enum ChargeStatus {
  PENDING
  REQUIRES_ACTION
  // Reserved on the card but not taken. A guest checkout stops here until
  // the session actually starts — see captureOrderPayment in
  // lib/orderPayments.ts. Accounts never enter this state.
  AUTHORIZED
  SUCCEEDED
  FAILED
  REFUNDED
  // An authorisation that was released instead of captured. No money ever
  // moved, so unlike REFUNDED it costs no processing fee.
  VOIDED
}

enum ChargeKind {
  ORDER
  EXTRA_GAMES
  TIP
  // Buying store credit. The credit itself is only granted once the webhook
  // confirms the charge, never on the redirect back.
  CREDITS
}

/**
 * One attempt to take money, mirrored from Stripe.
 *
 * Stripe stays the source of truth for whether money moved; this table exists
 * so the app can answer "what did this customer pay for" without calling the
 * API, and so a webhook has somewhere to land. The unique payment-intent id
 * is what makes replayed webhooks harmless.
 */
model Charge {
  id                    String       @id @default(cuid())
  userId                String?
  user                  User?        @relation(fields: [userId], references: [id])
  /** Set for guest checkouts, which have no account behind them. */
  guestEmail            String?
  orderId               String?
  order                 Order?       @relation(fields: [orderId], references: [id])
  savedCardId           String?
  savedCard             SavedCard?   @relation(fields: [savedCardId], references: [id])
  kind                  ChargeKind   @default(ORDER)
  status                ChargeStatus @default(PENDING)
  amountEUR             Decimal      @db.Decimal(10, 2)
  stripePaymentIntentId String?      @unique
  stripeSessionId       String?      @unique
  failureMessage        String?
  /**
   * Set by whoever first hands out what this charge bought. The action that
   * took the money and the webhook that confirms it both race for this, and
   * claiming it is a conditional update — so the games are added, or the tip
   * credited, exactly once no matter who gets there first.
   */
  fulfilledAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([orderId])
}

/**
 * The customer's in-game identity for one game — IGN, region and the roles
 * they want to play. Asked for before checkout so the teammate knows who to
 * add and where.
 */
model GameAccount {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSlug  String
  ign       String
  region    String
  roles     Json
  /** Current rank on the ladder from lib/gameProfiles, e.g. "emerald". */
  rank      String?
  /** IV–I, only for tiers that have sub-divisions. */
  division  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, gameSlug])
}

/**
 * A one-time link that lets someone register themselves as a teammate.
 *
 * Deliberately consumed on *registration*, not on opening: a link posted in
 * Discord is fetched by the unfurl bot before a human ever sees it, so an
 * open counter would burn the invite before it was used. Capping signups is
 * also what actually matters — the link can be forwarded to a hundred people
 * and still only ever create one account.
 */
model TeammateInvite {
  id           String    @id @default(cuid())
  /** The random secret in the URL. */
  token        String    @unique
  /** Free-text reminder of who this was meant for. */
  note         String?
  email        String?
  createdById  String
  createdBy    User      @relation("InvitesCreated", fields: [createdById], references: [id])
  expiresAt    DateTime
  /** Informational only — never gates anything, see the note above. */
  openCount    Int       @default(0)
  usedAt       DateTime?
  usedByUserId String?   @unique
  usedByUser   User?     @relation("InviteUsed", fields: [usedByUserId], references: [id])
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

// In-app notification feed. Every row targets one user; a platform event
// that concerns the admins fans out to one row per admin, so read state is
// per person rather than shared.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?  @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

enum CreditTxType {
  TOPUP
  BONUS
  ADMIN_ADJUST
  SPEND
  REFUND
}

// Store credit ledger — every balance change is a row here, User.
// creditBalanceCents is a denormalized running total kept in sync inside
// the same transaction as each insert (see purchaseCredits action), so the
// balance is cheap to read while the ledger stays the source of truth /
// audit trail. A topup package with a bonus writes two rows (TOPUP +
// BONUS) rather than one, so the bonus portion stays visible as its own
// line in a future transaction-history view.
model CreditTransaction {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  /// The order this movement belongs to, where there is one — the booking a
  /// SPEND paid for, or the cancellation a REFUND gives back. Null for
  /// topups, bonuses and manual adjustments, which stand on their own.
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        CreditTxType
  amountCents Int
  note        String?
  createdAt   DateTime     @default(now())

  // Makes refunding an order idempotent: a cancellation that runs twice hits
  // this constraint instead of crediting the balance again. Postgres treats
  // NULLs as distinct, so rows without an order aren't affected by it — the
  // same trade TeammateEarning makes for ADJUSTMENT rows.
  @@unique([userId, orderId, type])
  @@index([userId])
  @@index([orderId])
}

enum Role {
  CLIENT
  TEAMMATE
  ADMIN
}

// The booster/duo-partner roster — currently the static TEAMMATES array in
// src/lib/teammates.ts. `available` folds in what used to be the separate
// lib/availability.ts localStorage flag (that store had nothing else to key
// off of besides "the one demo teammate", so it lives on the row now).
model Teammate {
  id             String   @id
  // Roster number shown in the admin list. Separate from User.accountNo
  // because some legacy roster rows were never linked to an account.
  teammateNo     Int      @unique @default(autoincrement())
  userId         String?  @unique
  user           User?    @relation("UserTeammate", fields: [userId], references: [id])
  name           String
  avatarInitials String
  tagline        String?  @db.Text
  timezone       String?
  rating         Float    @default(5.0)
  sessionsCount  Int      @default(0)
  gameSlugs      Json
  languages      Json
  // Per-game profile map: { [gameSlug]: { rank, roles[], pool[] } } — see
  // lib/gameProfiles.ts. The lol* columns below are the legacy League-only
  // shape, still written (mirrored from gameProfiles) so the matchmaking
  // cards and any older rows keep rendering.
  gameProfiles   Json?
  lolRank        String?
  lolChampions   Json?
  lolLanes       Json?
  avatarUrl      String?  @db.Text
  // How the uploaded picture sits inside whatever frame it is drawn in — the
  // focal point as a percentage of the image, plus a zoom in percent. Set in
  // the profile editor by dragging the picture around, the way every social
  // network lets you place your own photo, and applied as object-position /
  // scale wherever an avatar is rendered.
  avatarFocusX   Int      @default(50)
  avatarFocusY   Int      @default(50)
  avatarZoom     Int      @default(100)
  available      Boolean  @default(true)
  availableSince DateTime?
  /// Regions this teammate plays in, e.g. ["euw","eune"]. Empty or null means
  /// no restriction — an order for any region may reach them.
  regions        Json?
  /// "Only alert me up to Diamond", set by the teammate themselves.
  maxRankSelf    String?
  /// The ceiling an admin has cleared them for. Wins over maxRankSelf, so
  /// nobody can opt into orders above what we've approved them for.
  maxRankAdmin   String?
  lastSeenAt     DateTime?
  lastDispatchAt DateTime?
  lastAssignedAt DateTime?
  createdAt      DateTime @default(now())

  // Running total of everything in `earnings`. Kept as a column so the
  // dashboards don't have to sum the ledger on every request; it is only
  // ever written in the same transaction as the ledger row.
  balanceEUR     Decimal  @default(0) @db.Decimal(10, 2)

  candidacies       DispatchCandidate[]
  reviewsReceived   Review[]
  verification      TeammateVerification?
  payoutMethods     PayoutMethod[]
  favoredBy         FavoriteTeammate[]
  earnings          TeammateEarning[]
  payoutRequests    PayoutRequest[]
  tipsReceived      Tip[]                @relation("TipsReceived")
}

enum TeammateEarningType {
  // Credited when an order completes — the teammate's share of the price.
  ORDER_PAYOUT
  // The customer's tip for a session, credited in full.
  TIP
  // Booked negative when an admin actually pays the balance out.
  PAYOUT_SENT
  // Manual correction by an admin, either direction.
  ADJUSTMENT
}

// Append-only ledger behind Teammate.balanceEUR. Never update a row here —
// corrections are a new ADJUSTMENT entry, so the history stays auditable.
model TeammateEarning {
  id         String              @id @default(cuid())
  teammateId String
  teammate   Teammate            @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?              @relation(fields: [orderId], references: [id])
  type       TeammateEarningType @default(ORDER_PAYOUT)
  amountEUR  Decimal             @db.Decimal(10, 2)
  note       String?
  createdAt  DateTime            @default(now())

  // Makes crediting an order idempotent: a second completeOrder() call for
  // the same teammate hits this constraint instead of paying twice. Postgres
  // treats NULLs as distinct, so ADJUSTMENT rows (orderId null) aren't
  // affected by it.
  @@unique([teammateId, orderId, type])
  @@index([teammateId, createdAt])
}

model FavoriteTeammate {
  clientUserId String
  teammateId   String
  clientUser   User     @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  teammate     Teammate @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([clientUserId, teammateId])
  @@index([teammateId])
}

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

// Identity check a teammate has to pass before payouts are released. The
// document columns hold private Storage object paths (bucket "kyc"), never
// public URLs — they're only ever served through short-lived signed links,
// see lib/storage.ts.
model TeammateVerification {
  id           String             @id @default(cuid())
  teammateId   String             @unique
  teammate     Teammate           @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  fullName     String?
  dateOfBirth  String?
  address      String?
  country      String?
  idFrontPath  String?
  idBackPath   String?
  selfiePath   String?
  status       VerificationStatus @default(UNSUBMITTED)
  reviewNote   String?            @db.Text
  submittedAt  DateTime?
  reviewedAt   DateTime?
  updatedAt    DateTime           @updatedAt
}

enum PayoutMethodType {
  BANK
  CRYPTO
}

// Where a teammate's payouts go. `details` is a type-specific bag (IBAN /
// SWIFT / beneficiary for BANK, coin / network / wallet for CRYPTO) so a new
// payout rail doesn't need a migration — see lib/payoutMethods.ts.
model PayoutMethod {
  id         String           @id @default(cuid())
  teammateId String
  teammate   Teammate         @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  type       PayoutMethodType
  details    Json
  isDefault  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  payoutRequests PayoutRequest[]

  @@index([teammateId])
}

enum PayoutRequestStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}

/**
 * A teammate asking for their balance to be sent out.
 *
 * `amountEUR` is null when they asked for their full available balance. That
 * is stored as intent rather than as a number on purpose: requests are
 * processed on a schedule, and between asking on the 10th and being paid on
 * the 15th more sessions may have completed. "Everything I have" should mean
 * everything they have *when the money moves*, not a stale figure.
 */
model PayoutRequest {
  id             String              @id @default(cuid())
  requestNo      Int                 @unique @default(autoincrement())
  teammateId     String
  teammate       Teammate            @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  payoutMethodId String
  payoutMethod   PayoutMethod        @relation(fields: [payoutMethodId], references: [id])
  amountEUR      Decimal?            @db.Decimal(10, 2)
  /** Frozen at request time so a later fee change can't alter a quoted payout. */
  feePercent     Decimal             @db.Decimal(5, 2)
  note           String?
  status         PayoutRequestStatus @default(PENDING)

  // Filled in when it is actually settled.
  grossEUR       Decimal?            @db.Decimal(10, 2)
  feeEUR         Decimal?            @db.Decimal(10, 2)
  netEUR         Decimal?            @db.Decimal(10, 2)
  adminNote      String?
  processedById  String?
  processedBy    User?               @relation("PayoutsProcessed", fields: [processedById], references: [id])
  processedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([teammateId, createdAt])
  @@index([status])
}

enum OrderStatus {
  // Placed, but nobody has been invited yet because the money hasn't
  // arrived. Stripe's webhook is what moves it on to SEARCHING — see
  // activateOrderAfterPayment() in lib/dispatch/create.ts.
  AWAITING_PAYMENT
  SEARCHING
  CANDIDATES_READY
  SELECTING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CANCEL_PENDING
  NO_MATCH
}

// One booking — was DispatchOrder in src/lib/matchmaking/types.ts. The old
// `selectedTeammateId` / `selectedTeammateIds[]` fields don't need their own
// columns here: which candidates are "the team" is just
// DispatchCandidate.selected/isPrimary on this order's candidate rows.
model Order {
  id                  String    @id @default(cuid())
  orderNo             Int       @unique @default(autoincrement())
  /// Secret handle this order is reachable by from the outside: the checkout
  /// URL, the live order screen, and the links in confirmation mails. Kept
  /// separate from `id` because `id` is what every internal API route is
  /// keyed by — handing it out would make every such route guessable from a
  /// link a customer might paste anywhere.
  accessToken         String?   @unique
  clientUserId        String?
  clientUser          User?     @relation("ClientOrders", fields: [clientUserId], references: [id])
  customerLabel       String
  gameSlug            String
  gameName            String
  option              String
  priceEUR            Decimal   @db.Decimal(10, 2)
  teammatesRequested  Int       @default(1)
  gamesBooked         Int       @default(1)
  requestedTeammateId String?
  status              OrderStatus @default(SEARCHING)
  /// Kept for the columns and screens written against it, but no longer a
  /// cut-off: the search runs until somebody accepts or the customer cancels,
  /// so this is set far ahead and never used to fail an order.
  dispatchDeadline    DateTime
  /// Which invite wave the order is on. 0 until the first one goes out.
  dispatchWave        Int       @default(0)
  /// When the current wave's alerts stop counting. The next wave goes out
  /// once this passes without enough acceptances.
  waveDeadline        DateTime?
  /// Set when a wave found nobody left to invite. The dispatcher waits a beat
  /// on this before starting over — teammates come online continuously, so an
  /// empty roster now is not an empty roster in fifteen seconds.
  poolExhaustedAt     DateTime?
  /// Admin hold. Waves stop going out; everything already in flight stands.
  matchingPaused      Boolean   @default(false)
  // When the order was actually fanned out to teammates — i.e. when the
  // payment cleared. The row itself is written at the top of checkout, so
  // createdAt is not when the search started.
  dispatchedAt        DateTime?
  selectionDeadline   DateTime?
  assignedAt          DateTime?
  rerollDeadline      DateTime?
  sessionStartAt      DateTime?
  sessionCompleteAt   DateTime?
  isReplay            Boolean   @default(false)
  vibe                String?
  conversationPref    String?
  playStylePref       String?
  cancelApprovedAt    DateTime?
  // What the teammate reports while playing — see lib/dispatch/types.ts.
  // Distinct from `status`, which is the order's own lifecycle.
  sessionStatus       String?
  teammatePayoutEUR   Decimal?  @db.Decimal(10, 2)
  createdAt           DateTime  @default(now())

  candidates DispatchCandidate[]
  dispatchEvents DispatchEvent[]
  games      SessionGame[]
  review     Review?
  earnings   TeammateEarning[]
  charges    Charge[]
  tip        Tip?
  couponsRedeemed Coupon[] @relation("CouponsRedeemed")
  creditMovements CreditTransaction[]
  /** Where confirmation and status mails go for an order placed without an
   * account. A signed-in order mails clientUser.email instead, so exactly
   * one of the two carries the address. */
  guestEmail  String?
  /** Snapshot of the in-game identity this order was booked with. */
  ign         String?
  ignRegion   String?
  ignRoles    Json?
  ignRank     String?
  ignDivision String?

  @@index([clientUserId])
  @@index([status])
}

model ConversationMessage {
  id              String   @id @default(cuid())
  conversationKey String
  sender          String
  text            String   @db.Text
  readBy          Json?
  createdAt       DateTime @default(now())

  @@index([conversationKey, createdAt])
}

enum CandidateStatus {
  PENDING
  ACCEPTED
  DECLINED
  TIMED_OUT
  /// The wave filled up while this alert was still on screen. Distinct from
  /// TIMED_OUT on purpose: nobody ignored anything here, they were simply
  /// beaten to it, and the priority scoring must never read this as a miss.
  SUPERSEDED
}

// One teammate's slot in an order's dispatch wave. `selected`/`isPrimary`
// mark which accepted candidates ended up on the booking — MySQL has no
// native array column, so this replaces DispatchOrder.selectedTeammateIds.
model DispatchCandidate {
  id                 String           @id @default(cuid())
  orderId            String
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  teammateId         String
  teammate           Teammate         @relation(fields: [teammateId], references: [id])
  status             CandidateStatus  @default(PENDING)
  // Only set for simulated candidates from the demo dispatcher; a real
  // teammate's row leaves these null and answers for itself.
  simulatedRespondAt DateTime?
  simulatedOutcome   CandidateStatus?
  invitedAt          DateTime         @default(now())
  expiresAt          DateTime?
  /// Which wave this invitation belongs to. A teammate who timed out early
  /// can be invited again in a later round, which overwrites this row — the
  /// dispatch log keeps the history.
  wave               Int              @default(1)
  /// When the teammate's browser confirmed the alert was on screen. A
  /// non-response only counts against them from this moment: before it, the
  /// silence was our delivery failing, not their attention.
  deliveredAt        DateTime?
  respondedAt        DateTime?
  /** 1-based order of acceptance — 1 is the auto-select. */
  candidatePosition  Int?
  isAutoSelect       Boolean          @default(false)
  selectedAt         DateTime?
  manual             Boolean          @default(false)
  selected           Boolean          @default(false)
  isPrimary          Boolean          @default(false)

  @@unique([orderId, teammateId])
  @@index([teammateId, status])
}

/// Append-only trace of everything the dispatcher did to an order.
///
/// Without it, "why did Kevin never get this order?" is unanswerable after
/// the fact: candidate rows only carry their final state, and a teammate who
/// was filtered out of the pool leaves no row at all. Rows are written from
/// inside the same transaction as the change they describe, so the log cannot
/// disagree with what happened.
model DispatchEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// See DISPATCH_EVENT in lib/dispatch/log.ts — a string rather than an enum
  /// so a new kind of entry doesn't need a migration.
  type       String
  /// Set when the entry is about one teammate.
  teammateId String?
  /// Human-readable line for the admin timeline.
  message    String   @db.Text
  /// Whatever numbers the entry carried — pool size, wave number, filter
  /// counts. Read by the admin view, never by the dispatcher itself.
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

// One played game inside an order. `proofPath` points at a private Storage
// object (bucket "proofs"), served through signed URLs like the KYC docs.
model SessionGame {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gameNumber  Int
  result      String
  note        String?  @db.Text
  proofPath   String?
  proofName   String?
  completedAt DateTime @default(now())

  @@unique([orderId, gameNumber])
  @@index([orderId])
}

// One rating per order, same rule as the old lib/reviews.ts (re-rating an
// order overwrites via the orderId unique constraint instead of stacking).
model Review {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  teammateId    String
  teammate      Teammate @relation(fields: [teammateId], references: [id])
  clientUserId  String?
  clientUser    User?    @relation("ReviewsWritten", fields: [clientUserId], references: [id])
  rating        Int
  createdAt     DateTime @default(now())

  @@index([teammateId])
}

// A discount code the customer owns. Was localStorage, which meant a code
// only existed in the browser that earned it and could be re-used by
// clearing site data — both gone now that redemption is decided server-side.
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  /** Where it came from: an order id for the post-session reward, or a campaign name. */
  source          String
  // Null for a public campaign code anyone may redeem; set for a code that
  // was earned by one account.
  ownerUserId     String?
  ownerUser       User?     @relation("CouponsOwned", fields: [ownerUserId], references: [id], onDelete: Cascade)
  // Redemption is one-shot: the timestamp is written in the same
  // transaction that places the order it paid for.
  usedAt          DateTime?
  usedOnOrderId   String?
  usedOnOrder     Order?    @relation("CouponsRedeemed", fields: [usedOnOrderId], references: [id])
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([ownerUserId, usedAt])
}

// A tip for a completed session. One per order — paying again for the same
// session replaces nothing, it is simply refused, so a double-clicked button
// cannot tip twice.
model Tip {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  teammateId String
  teammate   Teammate @relation("TipsReceived", fields: [teammateId], references: [id])
  fromUserId String?
  fromUser   User?    @relation("TipsSent", fields: [fromUserId], references: [id])
  amountEUR  Decimal  @db.Decimal(10, 2)
  /** The Stripe charge that paid for it; null when it was paid from credits. */
  chargeId   String?
  createdAt  DateTime @default(now())

  @@index([teammateId, createdAt])
}
